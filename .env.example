# LocaTS — Environment Configuration
# Copy this to .env and fill in your credentials.

# --- Supabase (Database + Auth) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-key
SUPABASE_BUCKET=locats-data

# --- Groq AI (LLM for AI Assistant) ---
# Get a free API key at https://console.groq.com
GROQ_API_KEY=

# --- Sentinel Hub (Satellite imagery) ---
# Get a key at https://apps.sentinel-hub.com/
SENTINEL_HUB_API_KEY=

# --- Twilio (SMS/OTP/Voice alerts) ---
# Get credentials at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE=

# --- Demo Credentials (development only) ---
# Login: admin@locats.gov.in / admin123
# Role: admin (full access)
# NOTE: Never use these in production. Create real accounts via Supabase Auth.
